<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      页面测试的空白 Compose 宿主。它只存在于 debug 变体，因此不会进入发布包。

      页面测试用 createComposeRule() 挂载被测页面，不需要每启动一个用例就把整个应用
      （Room、DataStore、计时服务）拉起来一遍——那会让设备在长页面的测试里反复被杀。
      页面自己的配色来自 Compose 的 AttentionTheme，因此不需要额外的平台主题。

      这个宿主没有 intent-filter，因此不声明 android:exported：createComposeRule() 由
      instrumentation 在本应用进程内启动它，同一个 uid 启动自己的 activity 不需要导出。
    -->
    <application>
        <activity android:name="androidx.activity.ComponentActivity" />

        <!--
          屏 01「她先开口」纯文字对话页的 debug 入口。带 LAUNCHER filter，装 debug 包后
          桌面会多一个图标，用来在真机上验收组件拼装结果。发布变体不含此 Activity。
        -->
        <activity
            android:name=".fuguang.specpreview.FuguangChatPageActivity"
            android:exported="true"
            android:label="新·浮光对话页"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          前端同学的「一周重排」六屏可交互原型。只在 debug 变体注册，用来对照
          Compose 实现与离线网页的差异。注意：交付包里原版清单把主应用入口
          （.MainActivity）用 tools:node="remove" 删掉了——那是给独立演示 APK 用的，
          这里保留主入口，否则装 debug 包进不去正式应用。
        -->
        <activity
            android:name=".fuguang.prototype.FuguangWeekPrototypeActivity"
            android:exported="true"
            android:label="浮光·一周重排原型"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 同一个原型的网页版（assets/fuguang/week_rearrange.html），用于逐拍对照。 -->
        <activity
            android:name=".fuguang.prototype.FuguangWeekWebInteractiveActivity"
            android:exported="true"
            android:label="浮光·一周重排网页版">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
